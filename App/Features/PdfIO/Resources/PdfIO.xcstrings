  "strings": {
    "%@ is a text document. Export it as a Sheafnote backup instead; PDF and image export is for notebooks with pages.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is a text document. Export it as a Sheafnote backup instead; PDF and image export is for notebooks with pages."
          }
        }
      }
    },
    "1-3, 5": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1-3, 5"
          }
        }
      }
    },
