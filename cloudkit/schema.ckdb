DEFINE SCHEMA

    RECORD TYPE SNAsset (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE QUERYABLE,
        "byteCount" INT64,
        "createdAt" TIMESTAMP,
        "data" ASSET,
        "deletedAt" TIMESTAMP,
        "filename" STRING,
        "formatVersion" INT64,
        "kind" STRING,
        "modifiedAt" TIMESTAMP,
        "sha256" STRING,
        "uti" STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE SNAudioRecording (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE QUERYABLE,
        "assetID" STRING,
        "createdAt" TIMESTAMP,
        "deletedAt" TIMESTAMP,
        "duration" DOUBLE,
        "formatVersion" INT64,
        "modifiedAt" TIMESTAMP,
        "notebookID" STRING,
        "startedAt" TIMESTAMP,
        "timeline" ASSET,
        "title" STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE SNBookmark (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE QUERYABLE,
        "createdAt" TIMESTAMP,
        "deletedAt" TIMESTAMP,
        "formatVersion" INT64,
        "modifiedAt" TIMESTAMP,
        "notebookID" STRING,
        "pageID" STRING,
        "title" STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE SNFlashcard (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE QUERYABLE,
        "backImage" ASSET,
        "backText" STRING,
        "createdAt" TIMESTAMP,
        "deck" STRING,
        "deletedAt" TIMESTAMP,
        "formatVersion" INT64,
        "frontImage" ASSET,
        "frontText" STRING,
        "modifiedAt" TIMESTAMP,
        "notebookID" STRING,
        "sourcePageID" STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE SNFolder (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE QUERYABLE,
        "colorName" STRING,
        "createdAt" TIMESTAMP,
        "deletedAt" TIMESTAMP,
        "formatVersion" INT64,
        "isFavorite" INT64,
        "modifiedAt" TIMESTAMP,
        "name" STRING,
        "parentID" STRING,
        "sortKey" STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE SNNotebook (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE QUERYABLE,
        "coverSpec" ASSET,
        "createdAt" TIMESTAMP,
        "defaultTemplate" BYTES,
        "deletedAt" TIMESTAMP,
        "folderID" STRING,
        "formatVersion" INT64,
        "isFavorite" INT64,
        "isLocked" INT64,
        "kind" STRING,
        "lastOpenedAt" TIMESTAMP,
        "modifiedAt" TIMESTAMP,
        "orientation" STRING,
        "paperColor" STRING,
        "paperSize" STRING,
        "pdfOutlineImported" INT64,
        "richText" ASSET,
        "scrollDirection" STRING,
        "sortKey" STRING,
        "title" STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE SNOutlineEntry (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE QUERYABLE,
        "createdAt" TIMESTAMP,
        "deletedAt" TIMESTAMP,
        "formatVersion" INT64,
        "modifiedAt" TIMESTAMP,
        "notebookID" STRING,
        "pageID" STRING,
        "parentID" STRING,
        "pdfPageIndex" INT64,
        "sortKey" STRING,
        "source" STRING,
        "title" STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE SNPage (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE QUERYABLE,
        "backgroundAssetID" STRING,
        "backgroundPageIndex" INT64,
        "createdAt" TIMESTAMP,
        "deletedAt" TIMESTAMP,
        "formatVersion" INT64,
        "heightPts" DOUBLE,
        "inkData" ASSET,
        "inkHash" STRING,
        "isInfinite" INT64,
        "modifiedAt" TIMESTAMP,
        "notebookID" STRING,
        "ocrInkHash" STRING,
        "paperColorOverride" STRING,
        "recognizedText" STRING,
        "sortKey" STRING,
        "strokeIDs" LIST<STRING>,
        "templateOverride" BYTES,
        "widthPts" DOUBLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE SNPageElement (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE QUERYABLE,
        "assetID" STRING,
        "createdAt" TIMESTAMP,
        "deletedAt" TIMESTAMP,
        "formatVersion" INT64,
        "height" DOUBLE,
        "kind" STRING,
        "modifiedAt" TIMESTAMP,
        "pageID" STRING,
        "payload" BYTES,
        "rotation" DOUBLE,
        "width" DOUBLE,
        "x" DOUBLE,
        "y" DOUBLE,
        "zIndex" INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE SNSavedElement (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE QUERYABLE,
        "category" STRING,
        "createdAt" TIMESTAMP,
        "deletedAt" TIMESTAMP,
        "elements" BYTES,
        "formatVersion" INT64,
        "height" DOUBLE,
        "inkData" ASSET,
        "modifiedAt" TIMESTAMP,
        "name" STRING,
        "thumbnail" ASSET,
        "width" DOUBLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE SNSetting (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE QUERYABLE,
        "createdAt" TIMESTAMP,
        "deletedAt" TIMESTAMP,
        "formatVersion" INT64,
        "key" STRING,
        "modifiedAt" TIMESTAMP,
        "valueJSON" BYTES,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE SNStudyState (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE QUERYABLE,
        "createdAt" TIMESTAMP,
        "deletedAt" TIMESTAMP,
        "dueAt" TIMESTAMP,
        "ease" DOUBLE,
        "flashcardID" STRING,
        "formatVersion" INT64,
        "intervalDays" INT64,
        "lapses" INT64,
        "lastReviewedAt" TIMESTAMP,
        "modifiedAt" TIMESTAMP,
        "repetitions" INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE,
        "roles" LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );
